FROM nvidia/cuda:12.1.1-devel-ubuntu22.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python-is-python3 \
    cmake build-essential git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
# Target GTX 1070 Ti (Compute Capability 6.1)
ENV CMAKE_ARGS="-DGGML_CUDA=on -DCMAKE_CUDA_ARCHITECTURES=61"
ENV FORCE_CMAKE=1
RUN pip wheel --no-cache-dir llama-cpp-python

FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

# Prevent timezone prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# Fix libcudart not found error
ENV LD_LIBRARY_PATH=/usr/local/cuda-12.1/targets/x86_64-linux/lib:${LD_LIBRARY_PATH}
ENV PIP_ROOT_USER_ACTION=ignore
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python-is-python3 \
    curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir requests
COPY --from=builder /build/*.whl /tmp/
RUN pip install --no-cache-dir /tmp/*.whl && rm -rf /tmp/*.whl

COPY src /app/src
WORKDIR /app

CMD ["python3", "-m", "src.nodes.worker"]
